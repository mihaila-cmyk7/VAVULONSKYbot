# Токен от @BotFather
BOT_TOKEN=123456789:replace-with-your-token

# Необязательно: путь к лог-файлу (по умолчанию babel_bot.log рядом с ботом)
# LOG_FILE=babel_bot.log

# Источник поиска: auto (сайт, при сбое локальная библиотека) | site (только сайт) | local (только локально)
# BABEL_SOURCE=auto

# Переводчик: auto (Яндекс при наличии ключа, затем Google, MyMemory) |
# google | yandex | mymemory | список через запятую
# TRANSLATE_SOURCE=auto

# Ключ API Яндекс.Переводчика (необязательно, но в России обычно надёжнее остальных).
# Подходит ключ Yandex Cloud (начинается с AQVN) или старый ключ trnsl.1.1...
# YANDEX_TRANSLATE_KEY=

# Для отладки: =1 дописывает причину ошибки в чат
# DEBUG_ERRORS=1
